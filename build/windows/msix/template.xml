<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="playrelay.exe"
        Arguments=""
        InstallLocation="C:\Program Files\akfaiz\PlayRelay">
    </Installer>
    <PackageInformation
        PackageName="PlayRelay"
        PackageDisplayName="PlayRelay"
        PublisherName="CN=akfaiz"
        PublisherDisplayName="akfaiz"
        Version="0.1.0.0"
        PackageDescription="Game launcher with rclone cloud saves">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.akfaiz.playrelay"
                Description="Game launcher with rclone cloud saves"
                DisplayName="PlayRelay"
                ExecutableName="playrelay.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PlayRelay</DisplayName>
            <PublisherDisplayName>akfaiz</PublisherDisplayName>
            <Description>Game launcher with rclone cloud saves</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="playrelay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
