# build output: every build writes to dist/ (see CONTRIBUTING.md)
/dist/
# the old output folder
bin
# written at the repo root by older packaging scripts
/carryover.exe
/carryover.tar.xz
/Carryover.app
.docker-data
# written by scripts/stamp-version.sh for release builds
/internal/app/version/zz_release.go
# written by go test -coverprofile (CI uploads it to Codecov)
/coverage.txt
# Android (android/): Gradle output, the local SDK path, and the Go core built by scripts/android-bind.sh
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/app/libs/
# Android signing keys (scripts/android-build.*): kept outside the repository
*.jks
*.keystore
