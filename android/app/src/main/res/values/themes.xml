<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before it starts. -->
    <style name="Theme.Carryover" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF5F6F9</item>
    </style>

    <!-- LaunchActivity: shown over the frontend while the saves sync. -->
    <style name="Theme.Carryover.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
